# Caddy web server config for FriendFinder.
# setup.sh copies this to /etc/caddy/Caddyfile and replaces DOMAIN_NAME with your domain.
# Caddy gets and renews the HTTPS certificate by itself.

www.DOMAIN_NAME {
	redir https://DOMAIN_NAME{uri} permanent
}

DOMAIN_NAME {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# Everything under /api/ goes to the Python backend.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Everything else is the exported Next.js site (frontend/out).
	handle {
		root * /opt/friendfinder/frontend/out
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Unknown pages show the site's own "not found" page.
	handle_errors 404 {
		root * /opt/friendfinder/frontend/out
		rewrite * /404.html
		file_server
	}
}
