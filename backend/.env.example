# Copy this file to .env (in this same backend folder) and fill in the real values.
# .env is ignored by git and is never committed. Keep ONLY placeholders in this file.

# "development" on your computer, "production" on the live server.
# In production the demo-data reset command refuses to run unless you add --allow-production.
APP_ENV=development

# PostgreSQL connection string. Any of these work:
#   TigerData (Timescale Cloud): copy "Service URL" from the TigerData console, keep ?sslmode=require
#   Codespaces:                   postgresql://friendfinder:friendfinder@localhost:5432/friendfinder
#   Postgres on your computer:    postgresql://postgres:YOUR_PASSWORD@localhost:5432/friendfinder
DATABASE_URL=

# Signs login tokens. Must be at least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. Without a key, match notes use the labelled non-AI fallback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=12

# Lets judges click "Try the demo" without signing up. Set to false to turn it off.
DEMO_MODE_ENABLED=true

# Optional: a separate database for the tests. If empty, tests use DATABASE_URL,
# inside a temporary private schema that is deleted afterwards.
TEST_DATABASE_URL=
