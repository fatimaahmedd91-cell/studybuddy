# Copy this file to .env (in this same backend folder) and fill in the real values.
# .env is ignored by git and is never committed. Keep ONLY placeholders in this file.
# Everything except DATABASE_URL and JWT_SECRET is optional: missing services show "not set up" in the app.

# ---------- Basics ----------

# "development" on your computer, "production" on the live server.
# In production the demo-data reset command refuses to run unless you add --allow-production,
# and the age-check test mode is switched off.
APP_ENV=development

# PostgreSQL connection string. Any of these work:
#   TigerData (Timescale Cloud): copy "Service URL" from the TigerData console, keep ?sslmode=require
#   Codespaces:                   postgresql://friendfinder:friendfinder@localhost:5432/friendfinder
#   Postgres on your computer:    postgresql://postgres:YOUR_PASSWORD@localhost:5432/friendfinder
DATABASE_URL=

# Signs login tokens and memory photo links. Must be at least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- Policy (product decisions: see docs/PRE_LAUNCH_CHECKLIST.md) ----------

# Minimum age to join. 18 is the PROPOSED launch policy, pending the team's confirmation.
MIN_AGE=18
# The Terms version people accept. Raise it after a material change to the Terms:
# everyone is asked to accept again on their next visit.
TERMS_VERSION=draft-2026-10-18b

# ---------- Google Gemini (match notes, hangout suggestions, timetable import) ----------
# Get a key at https://aistudio.google.com/apikey. Without it, the app uses labelled non-AI suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=12

# ---------- Google Maps Platform (real venue search near a meeting area) ----------
# A SERVER key with the "Places API (New)" enabled. It's never sent to browsers.
# Restrict it to the Places API, and to your server's IP address if you can.
# Without it, planning still works and offers plain "search on Google Maps" links instead.
GOOGLE_MAPS_API_KEY=

# ---------- Email codes (Settings → Verification) ----------
# Any SMTP account works, for example Gmail with an "app password" (smtp.gmail.com, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Phone codes through Twilio Verify ----------
# Create a Verify service in the Twilio console. All three are needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------- Selfie age check ----------
# Empty = not available (no badge is ever shown). No real provider is integrated yet.
# "mock" = a clearly labelled TEST MODE that only works with APP_ENV=development and never shows a badge.
AGE_CHECK_PROVIDER=

# ---------- Demo mode ----------
# Lets judges click "Try the demo" without signing up. Set to false to turn it off.
DEMO_MODE_ENABLED=true

# ---------- One-program hosting (Docker / Render) ----------
# When true, the API also sends the website's pages from WEBSITE_DIR. Caddy does this on Vultr instead.
SERVE_WEBSITE=false
# WEBSITE_DIR=../frontend/out

# ---------- Tests ----------
# Optional: a separate database for the tests. If empty, tests use DATABASE_URL,
# inside a temporary private schema that is deleted afterwards.
TEST_DATABASE_URL=
